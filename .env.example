# Copy to .env (git-ignored). Placeholders only — never commit real values.
# Admin console login (empty = login disabled)
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_ACCESS_TOKEN=            # optional fixed session token; otherwise one is generated in live_dashboard/out/

# Bookmaker sessions (only for the optional Playwright session/placer modules)
BETANO_USER=
BETANO_EMAIL=
BETANO_PASSWORD=
BETANO_COOKIE_DIR=state/betano
BETANO_OTP_INBOX=state/betano/otp_inbox.jsonl
BETANO_HEADLESS=1
BETANO_KEEPALIVE_SEC=3000
BETANO_PROXY=                  # optional http://host:port
SUPERBET_USER=
SUPERBET_EMAIL=
SUPERBET_PASSWORD=
SUPERBET_COOKIE_DIR=state/superbet
SUPERBET_PROXY=
EGRESS_PROXY_ADDR=

# Safety gates — everything is dry-run unless you explicitly turn these on
REAL_BETANO_PLACE=0
BETANO_PLACE_EXECUTE=0
BETANO_WORKER_EXECUTE=0
BETANO_CASHOUT_EXECUTE=0
BETANO_PLACER_SIMULATE=1
BETANO_JOBS_DIR=
BETANO_PLACE_SHOT_DIR=state/betano
BETANO_SECRETS_JSON=state/secrets.json   # optional JSON {"card":{"BETANO_...":"..."}}
